[Unit]
Description=Live YOLO11m on the Pi camera (AI HAT+ 2), frames on port 8001 and in the web page
After=network.target hailo-ollama.service
Wants=hailo-ollama.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/hailo-live
ExecStart=/home/admin/hailo-live/run_live.sh
# Holds the camera while running. Stop it (sudo systemctl stop hailo-live) before
# rpicam-still or vlm_test.py --camera.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
