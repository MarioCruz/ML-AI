[Unit]
Description=Hailo Ollama LLM server (AI HAT+ 2 / Hailo-10H)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin
ExecStart=/usr/bin/hailo-ollama
Restart=on-failure
RestartSec=3
# HailoRT/zoo 5.3.0+: share the HAT with the camera pipeline (hailonet
# vdevice-group-id) and other HailoRT apps that use the same group id.
# Ignored by 5.2.0. Only one LLM/VLM can be loaded at a time regardless.
Environment=HAILO_OLLAMA_VDEVICE_GROUP_ID=HAILO_OLLAMA_SHARED
# Models are stored in /usr/share/hailo-ollama/models (blob dir owned by admin).
# Config: /etc/xdg/hailo-ollama/hailo-ollama.json

[Install]
WantedBy=multi-user.target
