[Unit]
Description=Hailo Ollama LLM server (AI HAT+ 2 / Hailo-10H)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin
ExecStart=/usr/bin/hailo-ollama
Restart=on-failure
RestartSec=3
# HailoRT/zoo 5.3.0+: share the HAT with other HailoRT apps that open their
# VDevice with this group id (hailo-live/live_yolo.py does). Only one LLM/VLM
# can be loaded at a time regardless.
Environment=HAILO_OLLAMA_VDEVICE_GROUP_ID=HAILO_OLLAMA_SHARED
# Models are stored in ~/.local/share/hailo-ollama/models (5.3.0+). Port and
# bind address come from OLLAMA_HOST (default 0.0.0.0:8000); the old
# hailo-ollama.json config file is gone since 5.3.0.

[Install]
WantedBy=multi-user.target
