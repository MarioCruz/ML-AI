[Unit]
Description=Ollama (stock, CPU) for the Pi assistant, user-local install in /home/admin/ollama
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/ollama
ExecStart=/home/admin/ollama/bin/ollama serve
Restart=always
RestartSec=3
# Loopback only; the web page (port 8002) proxies to it
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/home/admin/ollama/models
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1

[Install]
WantedBy=multi-user.target
