[Unit]
Description=Pi assistant web UI (Flask, port 8002)
After=network.target hailo-ollama.service
Wants=hailo-ollama.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/web
ExecStart=/home/admin/voice/.venv/bin/python /home/admin/web/app.py
# "always" so that deploy.sh can reload the app without sudo: it kills the
# process and systemd starts it again with the new files.
Restart=always
RestartSec=3
# Audio output for "speak replies": pw (PipeWire default sink), hdmi, usb, or an ALSA device
Environment=ASSISTANT_OUT=pw
# PipeWire runs in the admin user session; the service needs its socket
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
